---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CompanyDetails from '../components/CompanyDetails.astro';
import { getCompany, getHome, getUi, mailtoHref, telHref } from '../lib/content';

const ui = await getUi();
const home = await getHome();
const company = await getCompany();
const page = ui.contactPage;
---

<BaseLayout title={`${page.title} | ${company.brand}`} description={page.description}>
  <section class="section">
    <div class="container">
      <h1>{page.title}</h1>
      <p class="lead">{home.hero.cta}</p>

      <div class="contact-grid">
        <section class="card" aria-labelledby="company-heading">
          <h2 id="company-heading">{page.companyHeading}</h2>
          <ul class="contact-list">
            <li>{ui.footer.email}: <a href={mailtoHref(company.email)}>{company.email}</a></li>
            <li>{ui.footer.phone}: <a href={telHref(company.phone)}>{company.phone}</a></li>
          </ul>
          <CompanyDetails />
          <Button href={mailtoHref(company.email, ui.ctaMailSubject)} class="contact-cta">{home.hero.cta}</Button>
        </section>

        <!--
          Roadmap phase 3 connects this form to the backend (POST /leads). Until then it is disabled and has
          no action, so it cannot pretend to send anything.
        -->
        <section class="card" aria-labelledby="form-heading">
          <h2 id="form-heading">{page.formHeading}</h2>
          <p id="form-notice" class="notice">{page.formNotice}</p>
          <form class="form" aria-describedby="form-notice">
            <fieldset disabled>
              <legend class="visually-hidden">{page.formHeading}</legend>
              <label for="name">{page.formName}</label>
              <input id="name" name="name" type="text" autocomplete="name" />
              <label for="email">{page.formEmail}</label>
              <input id="email" name="email" type="email" autocomplete="email" />
              <label for="message">{page.formMessage}</label>
              <textarea id="message" name="message" rows="5"></textarea>
              <button type="submit" class="btn btn--secondary">{page.formSubmit}</button>
            </fieldset>
          </form>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    margin-top: 2rem;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }

  .contact-list li + li {
    margin-top: 0.375rem;
  }

  .contact-grid :global(.contact-cta) {
    margin-top: 1.5rem;
  }

  .notice {
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    border: 1px solid rgba(163, 230, 53, 0.4);
    background: rgba(132, 204, 22, 0.1);
  }

  .form fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
    opacity: 0.6;
  }

  .form label {
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .form input,
  .form textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  .form button {
    margin-top: 1rem;
    justify-self: start;
    cursor: not-allowed;
  }
</style>
