---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CompanyDetails from '../components/CompanyDetails.astro';
import { getCompany, getHome, getUi, mailtoHref, telHref, withContactLinks } from '../lib/content';

const ui = await getUi();
const home = await getHome();
const company = await getCompany();
const page = ui.contactPage;

// Read at build time. PUBLIC_ variables are public by design (the URL is visible in the browser anyway).
// Without it (e.g. a local build without .env) the page shows the e-mail/phone fallback instead of a form.
const apiBase = (import.meta.env.PUBLIC_API_BASE_URL ?? '').trim().replace(/\/+$/, '');
if (apiBase) assertApiUrl(apiBase);

/** Fails the build on a value the browser could not use (relative URL, or http:// = mixed content). */
function assertApiUrl(value: string) {
  let url: URL;
  try {
    url = new URL(value);
  } catch {
    throw new Error(`PUBLIC_API_BASE_URL must be an absolute https:// URL, got "${value}".`);
  }
  const local = url.hostname === '127.0.0.1' || url.hostname === 'localhost';
  if (url.protocol !== 'https:' && !(url.protocol === 'http:' && local)) {
    throw new Error(
      `PUBLIC_API_BASE_URL must use https:// (http:// only for 127.0.0.1 or localhost), got "${value}".`,
    );
  }
}
const privacyHtml = withContactLinks(page.formPrivacy, company);
const fallbackHtml = withContactLinks(page.formNoscript, company);
const errorHtml = withContactLinks(page.formError, company);
const fields = [
  { id: 'name', label: page.formName, type: 'text', autocomplete: 'name', maxlength: 200 },
  { id: 'email', label: page.formEmail, type: 'email', autocomplete: 'email', maxlength: 254 },
] as const;
---

<BaseLayout title={`${page.title} | ${company.brand}`} description={page.description}>
  <section class="section">
    <div class="container">
      <h1>{page.title}</h1>

      <div class="contact-grid">
        <section class="card" aria-labelledby="company-heading">
          <h2 id="company-heading">{page.companyHeading}</h2>
          <ul class="contact-list">
            <li>{ui.footer.email}: <a href={mailtoHref(company.email)}>{company.email}</a></li>
            <li>{ui.footer.phone}: <a href={telHref(company.phone)}>{company.phone}</a></li>
          </ul>
          <CompanyDetails />
          <Button href={mailtoHref(company.email, ui.ctaMailSubject)} class="contact-cta">{home.hero.cta}</Button>
        </section>

        <section class="card" aria-labelledby="form-heading">
          <h2 id="form-heading">{page.formHeading}</h2>
          {
            apiBase ? (
              <>
                {/* Visible until the script runs: with JavaScript off (or broken) visitors get e-mail/phone. */}
                <p class="notice" data-form-fallback set:html={fallbackHtml} />
                {/* method="post" without action: if the script ever fails to stop a native submit, data never lands in a URL. */}
                <form class="form" method="post" data-lead-form data-api={apiBase} hidden>
                  {fields.map((f) => (
                    <div class="field">
                      <label for={f.id}>{f.label}</label>
                      <input
                        id={f.id}
                        name={f.id}
                        type={f.type}
                        autocomplete={f.autocomplete}
                        maxlength={f.maxlength}
                        required
                      />
                      <p id={`${f.id}-error`} class="field-error" hidden>
                        {page.formFieldErrors[f.id]}
                      </p>
                    </div>
                  ))}
                  <div class="field">
                    <label for="message">{page.formMessage}</label>
                    <textarea id="message" name="message" rows="5" maxlength="5000" required />
                    <p id="message-error" class="field-error" hidden>
                      {page.formFieldErrors.message}
                    </p>
                  </div>
                  {/* Honeypot: invisible to people and screen readers; bots that fill it are dropped by the API. */}
                  <div class="hp" aria-hidden="true">
                    <label for="website">{page.formHoneypot}</label>
                    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
                  </div>
                  <button type="submit" class="btn btn--primary" data-sending={page.formSending}>
                    {page.formSubmit}
                  </button>
                  <p class="privacy" set:html={privacyHtml} />
                </form>
                {/* One live region for every state; the script fills it from the templates below. */}
                <div class="form-status" role="status" aria-live="polite" tabindex="-1" data-form-status />
                <template data-msg="sending">{page.formSending}</template>
                <template data-msg="invalid">{page.formInvalid}</template>
                <template data-msg="error">
                  <p set:html={errorHtml} />
                </template>
                <template data-msg="success">
                  <h3>{page.formSuccessHeading}</h3>
                  <p>{page.formSuccessText}</p>
                </template>
              </>
            ) : (
              <p class="notice">{page.formNotice}</p>
            )
          }
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    margin-top: 2rem;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }

  .contact-list li + li {
    margin-top: 0.375rem;
  }

  .contact-grid :global(.contact-cta) {
    margin-top: 1.5rem;
  }

  .notice {
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    border: 1px solid rgba(163, 230, 53, 0.4);
    background: rgba(132, 204, 22, 0.1);
  }

  .form {
    display: grid;
    gap: 1rem;
  }

  .form[hidden] {
    display: none;
  }

  .field {
    display: grid;
    gap: 0.375rem;
  }

  .form label {
    font-weight: 500;
  }

  .form input,
  .form textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  .form [aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .field-error {
    margin: 0;
    color: var(--color-error);
    font-size: 0.9375rem;
  }

  .form button {
    justify-self: start;
  }

  .privacy {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .form button:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  /* Off-screen rather than display:none, so naive bots still see and fill it. */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-status:not(:empty) {
    margin-top: 1rem;
  }

  .form-status--error,
  .form-status--invalid {
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-error);
  }

  .form-status--error :global(p) {
    margin: 0;
  }

  .form-status--success {
    padding: 1rem;
    border-radius: var(--radius);
    border: 1px solid rgba(163, 230, 53, 0.4);
    background: rgba(132, 204, 22, 0.1);
  }

  .form-status :global(h3) {
    margin-top: 0;
  }
</style>

<script>
  // Bundled by Astro into a small module; runs only on this page. No framework, no logging of form data.
  type Field = 'name' | 'email' | 'message';
  const FIELDS: Field[] = ['name', 'email', 'message'];

  const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const fallback = document.querySelector<HTMLElement>('[data-form-fallback]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form && status && fallback && button) {
    const idleLabel = button.textContent ?? '';
    let busy = false;

    form.hidden = false;
    fallback.hidden = true;

    const show = (msg: 'sending' | 'invalid' | 'error' | 'success', focus: boolean) => {
      const template = document.querySelector<HTMLTemplateElement>(`template[data-msg="${msg}"]`);
      status.replaceChildren(template ? template.content.cloneNode(true) : '');
      status.className = `form-status form-status--${msg}`;
      if (focus) status.focus();
    };

    const input = (field: Field) => form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement;
    const errorEl = (field: Field) => document.getElementById(`${field}-error`) as HTMLElement;

    const setInvalid = (field: Field, invalid: boolean) => {
      const el = input(field);
      errorEl(field).hidden = !invalid;
      // aria-describedby only while the error is shown: hidden elements still count for descriptions.
      if (invalid) {
        el.setAttribute('aria-invalid', 'true');
        el.setAttribute('aria-describedby', `${field}-error`);
      } else {
        el.removeAttribute('aria-invalid');
        el.removeAttribute('aria-describedby');
      }
    };

    /** Field names the API rejected (400 `details[].field`), limited to fields this form has. */
    const rejectedFields = async (res: Response): Promise<Field[]> => {
      try {
        const body = (await res.json()) as { details?: { field?: unknown }[] };
        const names = (body.details ?? []).map((d) => String(d.field));
        return FIELDS.filter((f) => names.includes(f));
      } catch {
        return [];
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (busy) return;
      busy = true;
      FIELDS.forEach((f) => setInvalid(f, false));

      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '');
      const payload = {
        name: value('name').trim(),
        email: value('email').trim(),
        message: value('message').trim(),
        website: value('website'),
      };

      button.disabled = true;
      button.textContent = button.dataset.sending ?? idleLabel;
      form.setAttribute('aria-busy', 'true');
      show('sending', false);

      let invalid: Field[] = [];
      let ok = false;
      // AbortController + setTimeout instead of AbortSignal.timeout(), which Safari < 16 lacks.
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 15000);
      try {
        const res = await fetch(`${form.dataset.api}/leads`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        ok = res.ok;
        if (res.status === 400) invalid = await rejectedFields(res);
      } catch {
        // Network error, timeout or CORS rejection: handled as a generic error below.
      } finally {
        window.clearTimeout(timer);
      }

      form.removeAttribute('aria-busy');
      busy = false;
      if (ok) {
        form.reset();
        form.hidden = true;
        show('success', true);
        return;
      }
      button.disabled = false;
      button.textContent = idleLabel;
      if (invalid.length > 0) {
        invalid.forEach((f) => setInvalid(f, true));
        show('invalid', false);
        input(invalid[0]).focus();
      } else {
        show('error', true);
      }
    });
  }
</script>
