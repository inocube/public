---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyArticle from '../components/CaseStudyArticle.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { getCaseStudies, getCompany, getHome, getUi } from '../lib/content';

const ui = await getUi();
const home = await getHome();
const company = await getCompany();
const caseStudies = await getCaseStudies();
const page = ui.caseStudiesPage;
---

<BaseLayout title={`${page.title} | ${company.brand}`} description={page.description}>
  <section class="section page-head">
    <div class="container">
      <h1>{page.title}</h1>
      <p class="lead">{page.lead}</p>
    </div>
  </section>

  <div class="container studies">
    {caseStudies.map((entry) => <CaseStudyArticle entry={entry} />)}
  </div>

  <CtaBanner heading={home.cta.heading} />
</BaseLayout>

<style>
  .page-head {
    padding-bottom: 2rem;
  }

  .studies {
    display: grid;
    gap: 1.5rem;
  }
</style>
