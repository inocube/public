---
import LogoMark from './LogoMark.astro';
import CompanyDetails from './CompanyDetails.astro';
import { getCompany, getPackages, getUi, mailtoHref, packageUrl, telHref } from '../lib/content';

const ui = await getUi();
const company = await getCompany();
const packages = await getPackages();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <p class="footer__name"><LogoMark size={34} /> {company.brand}</p>
      <p class="footer__tagline">{company.tagline}</p>
    </div>

    <div>
      <h2 class="footer__heading">{ui.footer.contactHeading}</h2>
      <ul class="footer__list">
        <li>{ui.footer.email}: <a href={mailtoHref(company.email)}>{company.email}</a></li>
        <li>{ui.footer.phone}: <a href={telHref(company.phone)}>{company.phone}</a></li>
      </ul>
    </div>

    <div>
      <h2 class="footer__heading">{ui.footer.companyHeading}</h2>
      <CompanyDetails />
    </div>

    <nav aria-labelledby="footer-nav-heading">
      <h2 id="footer-nav-heading" class="footer__heading">{ui.footer.navHeading}</h2>
      <ul class="footer__list">
        {
          packages.map((p) => (
            <li>
              <a href={packageUrl(p.id)}>{p.data.title}</a>
            </li>
          ))
        }
        <li><a href="/referencie/">{ui.nav.caseStudies}</a></li>
        <li><a href="/kontakt/">{ui.nav.contact}</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {year} {company.legalName}. {ui.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .footer__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .footer__name {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .footer__tagline {
    letter-spacing: 0.04em;
  }

  .footer__heading {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__list li + li {
    margin-top: 0.375rem;
  }

  .footer a {
    color: var(--color-text-muted);
  }

  .footer a:hover {
    color: var(--color-text);
  }

  .footer__bottom {
    margin-top: 2.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  .footer__bottom p {
    margin: 0;
  }
</style>
