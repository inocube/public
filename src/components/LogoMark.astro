---
// Cube mark of the previous site (a "box" icon on the brand gradient), inlined so it costs no request.
// Icon geometry from Lucide (ISC licence).
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---

<span class="mark" style={`--size: ${size}px`} aria-hidden="true">
  <svg viewBox="0 0 24 24" width="60%" height="60%" fill="none" stroke="currentColor" stroke-width="2"
    stroke-linecap="round" stroke-linejoin="round" focusable="false">
    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
    <path d="m3.3 7 8.7 5 8.7-5" />
    <path d="M12 22V12" />
  </svg>
</span>

<style>
  .mark {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--size);
    height: var(--size);
    border-radius: calc(var(--size) * 0.3);
    background: var(--gradient-brand);
    color: #fff;
  }
</style>
