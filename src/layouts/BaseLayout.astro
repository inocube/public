---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCompany, getUi } from '../lib/content';
import ogSource from '../assets/brand/logo-light.png';

interface Props {
  /** Full <title>; every page passes its own. */
  title: string;
  description: string;
  /** Set to true on pages that must not be indexed (404). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const ui = await getUi();
const company = await getCompany();

// Astro.site comes from `site` in astro.config.mjs, so canonical and OG URLs are absolute.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: ogSource, width: 1024, height: 1024, format: 'jpg', quality: 80 });
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0c1222" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.brand} />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width ?? 1024)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height ?? 1024)} />
    <meta name="twitter:card" content="summary" />

    <Font cssVariable="--font-inter" preload />
  </head>
  <body>
    <a class="skip-link" href="#content">{ui.skipLink}</a>
    <Header />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: 600;
  }

  .skip-link:focus {
    top: 1rem;
  }

  main:focus {
    outline: none;
  }
</style>
