# Local development only. Copy to .env. Never commit .env.
# Variables prefixed PUBLIC_ are embedded in the built site: never put secrets in them.
# Production values are set in Netlify site settings, not here.

# Backend API base URL for the contact form (POST {PUBLIC_API_BASE_URL}/leads, roadmap phase 3). Read at build
# time; must be https:// (http:// only for 127.0.0.1/localhost) or the build fails. If empty, /kontakt/ shows
# the notice „Formulár zatiaľ nie je v prevádzke…“ instead of the form.
PUBLIC_API_BASE_URL=http://127.0.0.1:3000
